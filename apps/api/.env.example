# Copy to .env: cp .env.example .env
# Validated at startup by src/config/env.ts

NODE_ENV=development

# 127.0.0.1 locally, 0.0.0.0 inside Docker
HOST=127.0.0.1
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Matches docker-compose.yml
DATABASE_URL=postgresql://fitness:fitness@localhost:5433/fitness
